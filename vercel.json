{
  "cleanUrls": true,
  "redirects": [
    { "source": "/categories", "destination": "/latest-jobs", "permanent": true },
    { "source": "/jobs", "destination": "/latest-jobs", "permanent": true },
    { "source": "/admit-card", "destination": "/admit-cards", "permanent": true }
  ],
  "rewrites": [
    { "source": "/detail", "destination": "/detail.html" },
    { "source": "/detail/:id*", "destination": "/detail.html" },
    { "source": "/job/:slug*", "destination": "/job.html" },
    { "source": "/job", "destination": "/job.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
