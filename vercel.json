{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/categories",
      "destination": "/latest-jobs",
      "permanent": true
    },
    {
      "source": "/jobs",
      "destination": "/latest-jobs",
      "permanent": true
    },
    {
      "source": "/admit-card",
      "destination": "/admit-cards",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/detail",
      "destination": "/detail.html"
    },
    {
      "source": "/detail/:id*",
      "destination": "/detail.html"
    },
    {
      "source": "/job/:slug*",
      "destination": "/job.html"
    },
    {
      "source": "/job",
      "destination": "/job.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/portal_data.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/pdfs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}